<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="FORMA Studio: academia, musculação e treinos para sua rotina.">

    <title>FORMA Studio | Academia</title>

    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>

    <header class="header">
        <a class="logo" href="#inicio">FORMA<span>.</span></a>

        <button class="menu-toggle" id="menu-toggle"
                aria-label="Abrir menu" aria-expanded="false"
                aria-controls="menu">
            ☰
        </button>

        <nav class="menu" id="menu">
            <a href="#inicio">Início</a>
            <a href="#sobre">Sobre</a>
            <a href="#modalidades">Modalidades</a>
            <a href="#planos">Planos</a>
            <a class="menu-cta" href="#contato">Comece agora</a>
        </nav>
    </header>

    <main>
        <section class="hero" id="inicio">
            <div class="hero-content">
                <span class="tag">SEU PRÓXIMO NÍVEL COMEÇA AQUI</span>

                <h1>Construa sua melhor versão<span>.</span></h1>

                <p>
                    Um espaço para treinar, evoluir e cuidar de você.
                    No seu ritmo, com acompanhamento e estrutura de qualidade.
                </p>

                <a class="button" href="#planos">Conheça nossos planos ↗</a>

                <div class="hero-info">
                    <div>
                        <strong>100%</strong>
                        <span>Foco em você</span>
                    </div>
                    <div>
                        <strong>+ Energia</strong>
                        <span>Para sua rotina</span>
                    </div>
                </div>
            </div>

            <div class="hero-image" role="img"
                 aria-label="Ambiente moderno de academia">
                <div class="image-label">
                    <span class="status-dot"></span>
                    SEU ESPAÇO DE EVOLUÇÃO
                </div>
            </div>
        </section>

        <section class="about section" id="sobre">
            <div>
                <span class="tag">SOBRE A FORMA</span>
                <h2>Mais que treino.<br>Um estilo de vida.</h2>
            </div>

            <div class="about-text">
                <p>
                    Acreditamos que cada pessoa tem seu próprio ritmo.
                    Por isso, criamos um ambiente acolhedor para você
                    desenvolver força, confiança e bons hábitos.
                </p>
                <a class="text-link" href="#modalidades">
                    Descubra nossa estrutura →
                </a>
            </div>
        </section>

        <section class="section modalities" id="modalidades">
            <div class="section-heading">
                <div>
                    <span class="tag">ENCONTRE SEU TREINO</span>
                    <h2>Feito para você.</h2>
                </div>
                <p>Opções para diferentes objetivos e rotinas.</p>
            </div>

            <div class="card-grid">
                <article class="feature-card">
                    <span class="card-number">01 / FORÇA</span>
                    <div class="card-icon">↗</div>
                    <h3>Musculação</h3>
                    <p>Treine com equipamentos variados e evolua no seu ritmo.</p>
                </article>

                <article class="feature-card">
                    <span class="card-number">02 / ENERGIA</span>
                    <div class="card-icon">✳</div>
                    <h3>Condicionamento</h3>
                    <p>Atividades para desenvolver resistência e disposição.</p>
                </article>

                <article class="feature-card">
                    <span class="card-number">03 / EQUILÍBRIO</span>
                    <div class="card-icon">◎</div>
                    <h3>Acompanhamento</h3>
                    <p>Orientação para treinar com segurança e consistência.</p>
                </article>
            </div>
        </section>

        <section class="plans section" id="planos">
            <div class="section-heading">
                <div>
                    <span class="tag">ESCOLHA SEU PLANO</span>
                    <h2>Seu treino, suas regras.</h2>
                </div>
                <p>Escolha a opção que combina com sua rotina.</p>
            </div>

            <div class="card-grid">
                <article class="plan-card">
                    <span class="plan-label">ESSENCIAL</span>
                    <h3>Plano Start</h3>
                    <p>Para começar sua jornada.</p>

                    <div class="price">R$ 89<span>/mês</span></div>

                    <ul>
                        <li>✓ Acesso à musculação</li>
                        <li>✓ Equipamentos completos</li>
                        <li>✓ Avaliação inicial</li>
                    </ul>

                    <a class="button button-light" href="#contato">
                        Tenho interesse
                    </a>
                </article>

                <article class="plan-card plan-featured">
                    <span class="plan-label">MAIS COMPLETO</span>
                    <h3>Plano Plus</h3>
                    <p>Para ampliar suas possibilidades.</p>

                    <div class="price">R$ 129<span>/mês</span></div>

                    <ul>
                        <li>✓ Tudo do Plano Start</li>
                        <li>✓ Aulas coletivas</li>
                        <li>✓ Acompanhamento periódico</li>
                    </ul>

                    <a class="button" href="#contato">Tenho interesse ↗</a>
                </article>
            </div>

            <p class="disclaimer">
                Valores ilustrativos para este projeto. Ajuste os preços e
                serviços antes de utilizar o site para uma academia real.
            </p>
        </section>

        <section class="contact section" id="contato">
            <div>
                <span class="tag">VAMOS COMEÇAR?</span>
                <h2>Seu próximo passo começa aqui.</h2>
                <p>Preencha seus dados para demonstrar o formulário do site.</p>
            </div>

            <form id="contact-form">
                <label for="nome">Seu nome</label>
                <input id="nome" name="nome" type="text"
                       placeholder="Como podemos te chamar?" required>

                <label for="email">Seu e-mail</label>
                <input id="email" name="email" type="email"
                       placeholder="voce@email.com" required>

                <button class="button" type="submit">Enviar interesse ↗</button>
                <p id="form-message" role="status" aria-live="polite"></p>
            </form>
        </section>
    </main>

    <footer class="footer">
        <a class="logo" href="#inicio">FORMA<span>.</span></a>

        <p>Feito para evoluir. © <span id="year"></span> FORMA Studio.</p>

        <a href="#inicio">Voltar ao topo ↑</a>
    </footer>

</body>
</html>
:root {
    --green: #c7f36b;
    --dark: #20231f;
    --gray: #70756d;
    --light: #f7f8f4;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--dark);
    background: var(--white);
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
    outline: 3px solid #7ba82b;
    outline-offset: 4px;
}

/* CABEÇALHO */

.header {
    min-height: 78px;
    padding: 18px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: white;
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid #eeeeea;
}

.logo {
    font-size: 1.7rem;
    font-weight: 900;
    letter-spacing: -1.5px;
}

.logo span,
.hero h1 span {
    color: #86b82f;
}

.menu {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 0.9rem;
}

.menu a {
    transition: color 0.2s;
}

.menu a:hover,
.text-link:hover {
    color: #78a72b;
}

.menu .menu-cta {
    background: var(--green);
    color: var(--dark);
    padding: 11px 18px;
    border-radius: 7px;
    font-weight: 700;
}

.menu-toggle {
    display: none;
    background: transparent;
    border: 0;
    font-size: 1.7rem;
    cursor: pointer;
}

/* APRESENTAÇÃO */

.hero {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    align-items: center;
    gap: 50px;
    padding: 70px 8% 85px;
    background: var(--light);
}

.hero-content h1 {
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    max-width: 650px;
    margin-bottom: 24px;
}

.hero-content > p {
    max-width: 490px;
    margin-bottom: 30px;
    font-size: 1.05rem;
}

.button {
    display: inline-block;
    border: 0;
    background: var(--green);
    color: var(--dark);
    padding: 15px 22px;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
}

.button:hover {
    background: #b8e657;
    transform: translateY(-2px);
}

.hero-info {
    display: flex;
    gap: 42px;
    margin-top: 45px;
}

.hero-info div {
    display: flex;
    flex-direction: column;
}

.hero-info strong {
    font-size: 1.15rem;
}

.hero-info span {
    color: var(--gray);
    font-size: 0.82rem;
}

.hero-image {
    min-height: 440px;
    border-radius: 18px;
    position: relative;
    overflow: hidden;
    background-color: #d9dfd2;
    background-image:
        linear-gradient(0deg, rgba(20, 25, 18, 0.35), transparent 45%),
        url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1100&q=85");
    background-position: center;
    background-size: cover;
}

.image-label {
    position: absolute;
    bottom: 22px;
    left: 22px;
    background: white;
    border-radius: 8px;
    padding: 12px 15px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1px;
}

.status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #8cba3e;
    border-radius: 50%;
    margin-right: 7px;
}

/* SOBRE */

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.about-text p {
    margin-bottom: 22px;
    max-width: 500px;
}

.text-link {
    font-weight: 700;
    font-size: 0.95rem;
}

/* MODALIDADES E PLANOS */

.modalities {
    background: var(--light);
}

.section {
    padding: 90px 8%;
}

.tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

h2,
h3 {
    line-height: 1.15;
    letter-spacing: -1px;
}

h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 25px;
    margin-bottom: 38px;
}

.section-heading > p {
    max-width: 310px;
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.feature-card,
.plan-card {
    background: white;
    border: 1px solid #e9ebe5;
    border-radius: 14px;
    padding: 28px;
}

.card-number,
.plan-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.4px;
}

.card-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    margin: 30px 0 22px;
    background: var(--green);
    border-radius: 12px;
    font-size: 1.6rem;
}

.feature-card h3,
.plan-card h3 {
    font-size: 1.4rem;
    margin-bottom: 12px;
}

.feature-card p,
.plan-card > p {
    font-size: 0.93rem;
}

.plans {
    background: white;
}

.plans .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 900px;
}

.plan-card {
    padding: 35px;
}

.plan-featured {
    background: var(--light);
    border: 2px solid var(--green);
}

.price {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 25px 0;
    letter-spacing: -1.5px;
}

.price span {
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--gray);
}

.plan-card ul {
    list-style: none;
    margin-bottom: 30px;
}

.plan-card li {
    padding: 7px 0;
    font-size: 0.92rem;
}

.button-light {
    background: #edf0e7;
}

.button-light:hover {
    background: #e0e5d6;
}

.disclaimer {
    max-width: 900px;
    margin-top: 20px;
    font-size: 0.8rem;
}

/* CONTATO */

.contact {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 60px;
    align-items: start;
    background: var(--light);
}

.contact h2 {
    max-width: 500px;
    margin-bottom: 20px;
}

.contact form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.contact label {
    font-size: 0.88rem;
    font-weight: 700;
}

.contact input {
    width: 100%;
    padding: 14px;
    border: 1px solid #dfe2d9;
    border-radius: 8px;
    background: white;
    margin-bottom: 10px;
}

.contact form .button {
    align-self: flex-start;
}

#form-message {
    font-size: 0.9rem;
}

/* RODAPÉ */

.footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 30px 8%;
}

.footer p,
.footer > a:last-child {
    font-size: 0.82rem;
}

.footer > a:last-child {
    font-weight: 700;
}

/* RESPONSIVIDADE */

@media (max-width: 850px) {
    .header {
        padding-inline: 5%;
    }

    .menu-toggle {
        display: block;
    }

    .menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        padding: 20px 5%;
        background: white;
        border-bottom: 1px solid #eeeeea;
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
    }

    .menu.open {
        display: flex;
    }

    .menu .menu-cta {
        text-align: center;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 55px 6%;
    }

    .hero-image {
        min-height: 340px;
    }

    .section {
        padding: 65px 6%;
    }

    .about,
    .contact {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .card-grid {
        grid-template-columns: 1fr;
    }

    .section-heading {
        align-items: start;
        flex-direction: column;
    }
}

@media (max-width: 520px) {
    .hero-content h1 {
        font-size: 2.7rem;
    }

    .hero-info {
        gap: 24px;
    }

    .hero-image {
        min-height: 280px;
    }

    .plans .card-grid {
        grid-template-columns: 1fr;
    }

    .plan-card {
        padding: 25px;
    }

    .footer {
        align-items: flex-start;
        flex-direction: column;
    }
}
const menuToggle = document.getElementById("menu-toggle");
const menu = document.getElementById("menu");

// Abrir e fechar o menu no celular
menuToggle.addEventListener("click", function () {
    const aberto = menu.classList.toggle("open");

    menuToggle.setAttribute("aria-expanded", aberto);
    menuToggle.setAttribute(
        "aria-label",
        aberto ? "Fechar menu" : "Abrir menu"
    );

    menuToggle.textContent = aberto ? "✕" : "☰";
});

// Fechar o menu após clicar em um link
menu.querySelectorAll("a").forEach(function (link) {
    link.addEventListener("click", function () {
        menu.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Abrir menu");
        menuToggle.textContent = "☰";
    });
});

// Atualizar o ano automaticamente
document.getElementById("year").textContent =
    new Date().getFullYear();

// Demonstrar o envio do formulário
const form = document.getElementById("contact-form");
const mensagem = document.getElementById("form-message");

form.addEventListener("submit", function (event) {
    event.preventDefault();

    const nome = document.getElementById("nome").value.trim();

    mensagem.textContent =
        `Obrigado, ${nome}! O formulário está funcionando.`;

    form.reset();
});
